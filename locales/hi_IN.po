msgid "1. Profiles Entity:"
msgstr "1. प्रोफ़ाइल के लिए इकाई:"

msgid "2. Groups Entity:"
msgstr "2. समूह के लिए इकाई:"

msgid "Active"
msgstr "सक्रिय"

msgid "Back"
msgstr "वापस"

msgid "Back to entities selection"
msgstr "इकाई चयन पर वापस जाएँ"

msgid "Can view the permissions matrix?"
msgstr "क्या अनुमति मैट्रिक्स देख सकते हैं?"

msgid "Check all"
msgstr "सभी चुनें"

msgid "Download table in CSV format"
msgstr "CSV प्रारूप में तालिका डाउनलोड करें"

msgid "Export to CSV"
msgstr "CSV में निर्यात करें"

msgid "First name"
msgstr "पहला नाम"

msgid "Generate Permissions Matrix"
msgstr "अनुमति मैट्रिक्स उत्पन्न करें"

msgid "Groups:"
msgstr "समूह:"

msgid "Hide/Show Columns (Visual Filter)"
msgstr "कॉलम छिपाएँ/दिखाएँ (विज़ुअल फ़िल्टर)"

msgid "Last name"
msgstr "अंतिम नाम"

msgid "No"
msgstr "नहीं"

msgid "Page"
msgstr "पृष्ठ"

msgid "Permissions Matrix"
msgstr "अनुमति मैट्रिक्स"

msgid "Permissions Matrix Generator"
msgstr "अनुमति मैट्रिक्स जेनरेटर"

msgid "Plugin Access Configuration"
msgstr "प्लगइन पहुँच कॉन्फ़िगरेशन"

msgid "Profiles:"
msgstr "प्रोफ़ाइल:"

msgid "Save"
msgstr "सहेजें"

msgid "Showing %1$s - %2$s of %3$s users"
msgstr "%3$s उपयोगकर्ताओं में से %1$s - %2$s दिखा रहा है"

msgid "This plugin requires GLPI 10.0.0 or higher."
msgstr "इस प्लगइन के लिए GLPI 10.0.0 या उच्चतर आवश्यक है।"

msgid "Total users found:"
msgstr "कुल उपयोगकर्ता मिले:"

msgid "Uncheck all"
msgstr "सभी अचयनित करें"

msgid "User"
msgstr "उपयोगकर्ता"

msgid "Yes"
msgstr "हाँ"

msgid "of"
msgstr "का"

msgid "Allow all profiles to generate the permissions matrix?"
msgstr "सभी प्रोफ़ाइलों को अनुमति मैट्रिक्स उत्पन्न करने की अनुमति दें?"

msgid "Notice:"
msgstr "सूचना:"

msgid ""
"To grant or remove access for a specific profile to the permissions matrix, "
"go to the desired profile and adjust this setting in the 'Permissions "
"Matrix' tab."
msgstr ""
"किसी विशिष्ट प्रोफ़ाइल को अनुमति मैट्रिक्स तक पहुंच प्रदान करने या हटाने के "
"लिए, वांछित प्रोफ़ाइल पर जाएं और 'अनुमतियां मैट्रिक्स' टैब में इस सेटिंग को "
"समायोजित करें।"

msgid "Security Recommendation:"
msgstr "सुरक्षा अनुशंसा:"

msgid ""
"It is strongly recommended to restrict this permission to Super-Admin "
"profiles only. Allowing this option for all enables regular users to view "
"sensitive assignment and group data across the entire system."
msgstr ""
"इस अनुमति को केवल सुपर-एडमिन प्रोफाइल तक ही सीमित रखने की पुरजोर अनुशंसा की "
"जाती है। सभी के लिए इस विकल्प की अनुमति देने से नियमित उपयोगकर्ता पूरे "
"सिस्टम में संवेदनशील असाइनमेंट और समूह डेटा देखने में सक्षम हो जाते हैं।"

msgid "Saving..."
msgstr "सहेजा जा रहा है..."

msgid "Permissions granted to all profiles."
msgstr "सभी प्रोफ़ाइलों को अनुमतियाँ प्रदान की गईं."

msgid "Permissions removed from all profiles (except Super-Admin)."
msgstr "सभी प्रोफ़ाइलों से अनुमतियाँ हटा दी गईं (सुपर-एडमिन को छोड़कर)।"
