msgstr "Jogosultsági Mátrix Generátor"

msgid "Plugin Access Configuration"
msgstr "Bővítmény Hozzáférési Beállítások"

msgid "Profiles:"
msgstr "Profilok:"

msgid "Save"
msgstr "Mentés"

msgid "Showing %1$s - %2$s of %3$s users"
msgstr "%1$s - %2$s / %3$s felhasználó mutatása"

msgid "This plugin requires GLPI 10.0.0 or higher."
msgstr "Ez a bővítmény GLPI 10.0.0 vagy újabb verziót igényel."

msgid "Total users found:"
msgstr "Összes megtalált felhasználó:"

msgid "Uncheck all"
msgstr "Összes kijelölés törlése"

msgid "User"
msgstr "Felhasználó"

msgid "Yes"
msgstr "Igen"

msgid "of"
msgstr "/"

msgid "Allow all profiles to generate the permissions matrix?"
msgstr "Engedélyezi az összes profilnak az engedélymátrix létrehozását?"

msgid "Notice:"
msgstr "Értesítés:"

msgid ""
"To grant or remove access for a specific profile to the permissions matrix, "
"go to the desired profile and adjust this setting in the 'Permissions "
"Matrix' tab."
msgstr ""
"Egy adott profil engedélymátrixhoz való hozzáférésének megadásához vagy "
"eltávolításához lépjen a kívánt profilra, és módosítsa ezt a beállítást az "
"„Engedélyek mátrixa” lapon."

msgid "Security Recommendation:"
msgstr "Biztonsági ajánlás:"

msgid ""
"It is strongly recommended to restrict this permission to Super-Admin "
"profiles only. Allowing this option for all enables regular users to view "
"sensitive assignment and group data across the entire system."
msgstr ""
"Erősen ajánlott ezt az engedélyt csak a Super-Admin profilokra korlátozni. "
"Ha ezt az opciót mindenki számára engedélyezi, a rendszeres felhasználók "
"megtekinthetik a bizalmas hozzárendelési és csoportos adatokat a teljes "
"rendszerben."

msgid "Saving..."
msgstr "Megtakarítás..."

msgid "Permissions granted to all profiles."
msgstr "Az összes profilhoz adott engedélyek."

msgid "Permissions removed from all profiles (except Super-Admin)."
msgstr "Az engedélyek eltávolítva az összes profilból (kivéve a Super-Admin)."
