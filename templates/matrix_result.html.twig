

<style>{{ inline_css|raw }}</style>
<script>{{ inline_js|raw }}</script>
<div class='center pm-app-wrapper' style='box-shadow: none;'>

<div class='pm-flex-between pm-box-header'>
    <div style='font-size: 15px; font-weight: bold; color: #333;'>
        <i class='fas fa-users' style='margin-right: 5px; color: #1d5ea3;'></i> {{ __('Total users found:', 'permissionsmatrix') }} <span style='color: #1d5ea3; font-size: 16px;'>{{ total_usuarios }}</span>
    </div>

    <div style='display: flex; gap: 10px;'>
        <a href='matrix.form.php' class='vsubmit pm-btn-dark' style='display: inline-flex; align-items: center;' title='{{ __('Back to entities selection', 'permissionsmatrix') }}'>⬅️ {{ __('Back', 'permissionsmatrix') }}</a>

        <form id='form-exportar' method='post' action='matrix.result.php' style='margin: 0;'>
            <input type='hidden' name='_glpi_csrf_token' value='{{ csrf_token }}'>
            
            {% for id_perfil in entidade_perfis %}
                <input type='hidden' name='entities_id_profiles[]' value='{{ id_perfil }}'>
            {% endfor %}
            {% for id_grupo in entidade_grupos %}
                <input type='hidden' name='entities_id_groups[]' value='{{ id_grupo }}'>
            {% endfor %}
            
            <input type='hidden' name='perfis_ativos' id='input_perfis_ativos' value=''>
            <input type='hidden' name='grupos_ativos' id='input_grupos_ativos' value=''>
            
            <button type='submit' name='exportar_csv' value='1' class='vsubmit pm-btn-green' title='{{ __('Download table in CSV format', 'permissionsmatrix') }}'>📥 {{ __('Export to CSV', 'permissionsmatrix') }}</button>
        </form>
    </div>
</div>

<div class='pm-box-header'>
    <div id='btn-toggle-filtro' style='cursor: pointer; text-align: center; color: #1d5ea3; font-weight: bold; font-size: 14px; padding: 5px;'>
        <i class='fas fa-filter'></i> {{ __('Hide/Show Columns (Visual Filter)', 'permissionsmatrix') }} <i class='fas fa-caret-down'></i>
    </div>

    <div id='conteudo-filtro' class='pm-filter-panel'>
        <div style='display: flex; gap: 20px; flex-wrap: wrap;'>
            
            <div style='flex: 1; min-width: 250px; text-align: left;'>
                <div style='display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;'>
                    <strong style='color: #555;'>{{ __('Profiles:', 'permissionsmatrix') }}</strong>
                    <div style='font-size: 12px;'>
                        <a href='#' class='acao-massa-perfil' data-acao='marcar' style='color: #1d5ea3; text-decoration: none;'>{{ __('Check all', 'permissionsmatrix') }}</a> | 
                        <a href='#' class='acao-massa-perfil' data-acao='desmarcar' style='color: #990000; text-decoration: none;'>{{ __('Uncheck all', 'permissionsmatrix') }}</a>
                    </div>
                </div>
                <div id='caixa-perfis' class='pm-filter-box'>
                    {% set col_index = 4 %}
                    {% for p in nomes_perfis %}
                        <label class='pm-filter-label'>
                            <input type='checkbox' class='col-filter' data-colindex='{{ col_index }}' value='{{ p }}' checked style='margin-right: 5px;'> {{ p }}
                        </label>
                        {% set col_index = col_index + 1 %}
                    {% endfor %}
                </div>
            </div>

            <div style='flex: 1; min-width: 250px; text-align: left;'>
                <div style='display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;'>
                    <strong style='color: #555;'>{{ __('Groups:', 'permissionsmatrix') }}</strong>
                    <div style='font-size: 12px;'>
                        <a href='#' class='acao-massa-grupo' data-acao='marcar' style='color: #1d5ea3; text-decoration: none;'>{{ __('Check all', 'permissionsmatrix') }}</a> | 
                        <a href='#' class='acao-massa-grupo' data-acao='desmarcar' style='color: #990000; text-decoration: none;'>{{ __('Uncheck all', 'permissionsmatrix') }}</a>
                    </div>
                </div>
                <div id='caixa-grupos' class='pm-filter-box'>
                    {% for g in nomes_grupos %}
                        <label class='pm-filter-label'>
                            <input type='checkbox' class='col-filter' data-colindex='{{ col_index }}' value='{{ g }}' checked style='margin-right: 5px;'> {{ g }}
                        </label>
                        {% set col_index = col_index + 1 %}
                    {% endfor %}
                </div>
            </div>

        </div>
    </div>
</div>

<div class='pm-table-container'>
    <table class='tab_cadre_fixehov pm-table-auto'>
        <tr class='pm-headerRow'>
            <th class='pm-freeze-col' data-colindex='0' style='text-align: center;'>{{ __('Active', 'permissionsmatrix') }}</th>
            <th class='pm-freeze-col' data-colindex='1' style='text-align: left;'>{{ __('User', 'permissionsmatrix') }}</th>
            <th class='pm-freeze-col' data-colindex='2' style='text-align: left;'>{{ __('First name', 'permissionsmatrix') }}</th>
            <th class='pm-freeze-col pm-freeze-shadow' data-colindex='3' style='text-align: left;'>{{ __('Last name', 'permissionsmatrix') }}</th>
            
            {% for p in nomes_perfis %}
                <th style='background-color: #999999; color: white; white-space: nowrap; text-align: center; padding: 5px 15px;'>{{ p }}</th>
            {% endfor %}
            {% for g in nomes_grupos %}
                <th style='background-color: #0b5394; color: white; white-space: nowrap; text-align: center; padding: 5px 15px;'>{{ g }}</th>
            {% endfor %}
        </tr>

        {% for uid, dados in usuarios_pagina %}
            <tr class='tab_bg_1'>
                {% set ativo_str = __('Yes', 'permissionsmatrix') %}
                {% set cur_ativo = dados.ativo ?? __('No', 'permissionsmatrix') %}
                {% set cor_ativo = cur_ativo == ativo_str ? 'color: #274e13; font-weight: bold; text-align: center;' : 'color: #990000; text-align: center;' %}

                <td class='pm-freeze-col' data-colindex='0' style='{{ cor_ativo }}'>{{ cur_ativo }}</td>
                <td class='pm-freeze-col' data-colindex='1' style='white-space: nowrap; text-align: left; color: #333333;'>{{ dados.login ?? '' }}</td>
                <td class='pm-freeze-col' data-colindex='2' style='white-space: nowrap; text-align: left; color: #333333;'>{{ dados.firstname ?? '' }}</td>
                <td class='pm-freeze-col pm-freeze-shadow' data-colindex='3' style='white-space: nowrap; text-align: left; color: #333333;'>{{ dados.realname ?? '' }}</td>
                
                {% for p in nomes_perfis %}
                    <td class='center pm-cell-profile' style='text-align: center;'>
                        {% if dados.perfis[p] is defined %}
                            <b style='color: #333;'>X</b>
                        {% endif %}
                    </td>
                {% endfor %}
                
                {% for g in nomes_grupos %}
                    <td class='center pm-cell-group' style='text-align: center;'>
                        {% if dados.grupos[g] is defined %}
                            <b style='color: #0b5394;'>X</b>
                        {% endif %}
                    </td>
                {% endfor %}
            </tr>
        {% endfor %}
    </table>
</div> 

{% if total_paginas > 1 %}
    <div class='pm-box-header pm-flex-center' style='flex-direction: column; gap: 10px; margin-bottom: 15px; background: #fff;'>
        <div class='pm-flex-center' style='gap: 15px;'>
            {% if pagina_atual > 1 %}
                <button data-page-action='go' data-page='1' class='pm-btn-paginacao pm-btn-dark'><i class='fas fa-angle-double-left'></i></button>
                <button data-page-action='go' data-page='{{ pagina_atual - 1 }}' class='pm-btn-paginacao pm-btn-blue'><i class='fas fa-chevron-left'></i></button>
            {% endif %}
            
            <span style='font-size: 14px; color: #555;'>{{ __('Page', 'permissionsmatrix') }} 
            <input type='number' data-page-action='jump' data-max-page='{{ total_paginas }}' value='{{ pagina_atual }}' min='1' max='{{ total_paginas }}' style='width: 60px; text-align: center; padding: 3px; border: 1px solid #ccc; border-radius: 4px; font-weight: bold;'> 
            {{ __('of', 'permissionsmatrix') }} <b>{{ total_paginas }}</b></span>
            
            {% if pagina_atual < total_paginas %}
                <button data-page-action='go' data-page='{{ pagina_atual + 1 }}' class='pm-btn-paginacao pm-btn-blue'><i class='fas fa-chevron-right'></i></button>
                <button data-page-action='go' data-page='{{ total_paginas }}' class='pm-btn-paginacao pm-btn-dark'><i class='fas fa-angle-double-right'></i></button>
            {% endif %}
        </div>
        <span style='font-size: 14px; color: #333;'>{{ texto_exibindo | raw }}</span>
    </div>
{% endif %}

</div>

<form id='form-paginacao' method='post' action='matrix.result.php' style='display:none;'>
    <input type='hidden' name='_glpi_csrf_token' value='{{ csrf_token }}'>
    <input type='hidden' name='gerar_matriz' value='1'>
    <input type='hidden' name='pagina' id='input_pagina' value='1'>
    {% for id_perfil in entidade_perfis %}
        <input type='hidden' name='entities_id_profiles[]' value='{{ id_perfil }}'>
    {% endfor %}
    {% for id_grupo in entidade_grupos %}
        <input type='hidden' name='entities_id_groups[]' value='{{ id_grupo }}'>
    {% endfor %}
</form>

</form>
