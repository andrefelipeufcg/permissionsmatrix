

<style>{{ inline_css|raw }}</style>

{# Dados de entidade para requisições AJAX (usados pelo JS) #}
<div id='pm-dados-ajax' style='display:none;'
     data-url='matrix.result.php'
     data-entidades-perfis='{{ entidade_perfis|join(",") }}'
     data-entidades-grupos='{{ entidade_grupos|join(",") }}'>
</div>

<div class='center pm-app-wrapper' style='box-shadow: none;'>

{# Overlay de carregamento #}
<div id='pm-loading-overlay' class='pm-loading-overlay' style='display: none;'>
    <div class='pm-loading-spinner'></div>
</div>

<div class='pm-flex-between pm-box-header'>
    <div style='font-size: 15px; font-weight: bold; color: #333;'>
        <i class='fas fa-users' style='margin-right: 5px; color: #1d5ea3;'></i> {{ __('Total users found:', 'permissionsmatrix') }} <span id='pm-total-usuarios' style='color: #1d5ea3; font-size: 16px;'>{{ total_usuarios }}</span>
    </div>

    <div style='display: flex; gap: 10px;'>
        <a href='matrix.form.php' class='vsubmit pm-btn-dark' style='display: inline-flex; align-items: center;' title='{{ __('Back to entities selection', 'permissionsmatrix') }}'>⬅️ {{ __('Back', 'permissionsmatrix') }}</a>

        <form id='form-exportar' method='post' action='matrix.result.php' style='margin: 0;'>
            <input type='hidden' name='_glpi_csrf_token' value='{{ csrf_token }}'>
            <input type='hidden' name='filtro_ativo' value='1'>
            
            {% for id_perfil in entidade_perfis %}
                <input type='hidden' name='entities_id_profiles[]' value='{{ id_perfil }}'>
            {% endfor %}
            {% for id_grupo in entidade_grupos %}
                <input type='hidden' name='entities_id_groups[]' value='{{ id_grupo }}'>
            {% endfor %}
            
            {# Container de inputs de filtro dinâmicos - atualizados pelo JS via AJAX #}
            <div id='pm-export-filtros'>
                {% for p in filtro_perfis_ativos %}
                    <input type='hidden' name='perfis_ativos[]' value='{{ p }}'>
                {% endfor %}
                {% for g in filtro_grupos_ativos %}
                    <input type='hidden' name='grupos_ativos[]' value='{{ g }}'>
                {% endfor %}
            </div>
            
            <button type='submit' name='exportar_csv' value='1' class='vsubmit pm-btn-green' title='{{ __('Download table in CSV format', 'permissionsmatrix') }}'>📥 {{ __('Export to CSV', 'permissionsmatrix') }}</button>
        </form>
    </div>
</div>

<div class='pm-box-header'>
    <div id='btn-toggle-filtro' style='cursor: pointer; text-align: center; color: #1d5ea3; font-weight: bold; font-size: 14px; padding: 5px;'>
        <i class='fas fa-filter'></i> {{ __('Hide/Show Columns (Visual Filter)', 'permissionsmatrix') }} <i class='fas fa-caret-down'></i>
    </div>

    <div id='conteudo-filtro' class='pm-filter-panel'>
        <div style='display: flex; gap: 20px; flex-wrap: wrap;'>
            
            <div style='flex: 1; min-width: 250px; text-align: left;'>
                <div style='display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;'>
                    <strong style='color: #555;'>{{ __('Profiles:', 'permissionsmatrix') }}</strong>
                    <div style='font-size: 12px;'>
                        <a href='#' class='acao-massa-perfil' data-acao='marcar' style='color: #1d5ea3; text-decoration: none;'>{{ __('Check all', 'permissionsmatrix') }}</a> | 
                        <a href='#' class='acao-massa-perfil' data-acao='desmarcar' style='color: #990000; text-decoration: none;'>{{ __('Uncheck all', 'permissionsmatrix') }}</a>
                    </div>
                </div>
                <div id='caixa-perfis' class='pm-filter-box'>
                    {% for p in nomes_perfis %}
                        <label class='pm-filter-label'>
                            <input type='checkbox' class='col-filter' data-tipo='perfil' value='{{ p }}' checked style='margin-right: 5px;'> {{ p }}
                        </label>
                    {% endfor %}
                </div>
            </div>

            <div style='flex: 1; min-width: 250px; text-align: left;'>
                <div style='display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;'>
                    <strong style='color: #555;'>{{ __('Groups:', 'permissionsmatrix') }}</strong>
                    <div style='font-size: 12px;'>
                        <a href='#' class='acao-massa-grupo' data-acao='marcar' style='color: #1d5ea3; text-decoration: none;'>{{ __('Check all', 'permissionsmatrix') }}</a> | 
                        <a href='#' class='acao-massa-grupo' data-acao='desmarcar' style='color: #990000; text-decoration: none;'>{{ __('Uncheck all', 'permissionsmatrix') }}</a>
                    </div>
                </div>
                <div id='caixa-grupos' class='pm-filter-box'>
                    {% for g in nomes_grupos %}
                        <label class='pm-filter-label'>
                            <input type='checkbox' class='col-filter' data-tipo='grupo' value='{{ g }}' checked style='margin-right: 5px;'> {{ g }}
                        </label>
                    {% endfor %}
                </div>
            </div>

        </div>
    </div>
</div>

{# Área que é atualizada via AJAX (tabela + paginação) #}
<div id='pm-resultado'>
    {% include '@permissionsmatrix/matrix_result_table.html.twig' %}
</div>

</div>

<script>{{ inline_js|raw }}</script>
