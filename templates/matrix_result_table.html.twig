<div class='pm-table-container'>
    <table class='tab_cadre_fixehov pm-table-auto'>
        <tr class='pm-headerRow'>
            <th class='pm-freeze-col' data-colindex='0' style='text-align: center;'>{{ __('Active', 'permissionsmatrix') }}</th>
            <th class='pm-freeze-col' data-colindex='1' style='text-align: left;'>{{ __('User', 'permissionsmatrix') }}</th>
            <th class='pm-freeze-col' data-colindex='2' style='text-align: left;'>{{ __('First name', 'permissionsmatrix') }}</th>
            <th class='pm-freeze-col pm-freeze-shadow' data-colindex='3' style='text-align: left;'>{{ __('Last name', 'permissionsmatrix') }}</th>
            
            {% for p in filtro_perfis_ativos %}
                <th style='background-color: #999999; color: white; white-space: nowrap; text-align: center; padding: 5px 15px;'>{{ p }}</th>
            {% endfor %}
            {% for g in filtro_grupos_ativos %}
                <th style='background-color: #0b5394; color: white; white-space: nowrap; text-align: center; padding: 5px 15px;'>{{ g }}</th>
            {% endfor %}
        </tr>

        {% for uid, dados in usuarios_pagina %}
            <tr class='tab_bg_1'>
                {% set ativo_str = __('Yes', 'permissionsmatrix') %}
                {% set cur_ativo = dados.ativo ?? __('No', 'permissionsmatrix') %}
                {% set cor_ativo = cur_ativo == ativo_str ? 'color: #274e13; font-weight: bold; text-align: center;' : 'color: #990000; text-align: center;' %}

                <td class='pm-freeze-col' data-colindex='0' style='{{ cor_ativo }}'>{{ cur_ativo }}</td>
                <td class='pm-freeze-col' data-colindex='1' style='white-space: nowrap; text-align: left; color: #333333;'>{{ dados.login ?? '' }}</td>
                <td class='pm-freeze-col' data-colindex='2' style='white-space: nowrap; text-align: left; color: #333333;'>{{ dados.firstname ?? '' }}</td>
                <td class='pm-freeze-col pm-freeze-shadow' data-colindex='3' style='white-space: nowrap; text-align: left; color: #333333;'>{{ dados.realname ?? '' }}</td>
                
                {% for p in filtro_perfis_ativos %}
                    <td class='center pm-cell-profile' style='text-align: center;'>
                        {% if dados.perfis[p] is defined %}
                            <b style='color: #333;'>X</b>
                        {% endif %}
                    </td>
                {% endfor %}
                
                {% for g in filtro_grupos_ativos %}
                    <td class='center pm-cell-group' style='text-align: center;'>
                        {% if dados.grupos[g] is defined %}
                            <b style='color: #0b5394;'>X</b>
                        {% endif %}
                    </td>
                {% endfor %}
            </tr>
        {% endfor %}
    </table>
</div>

{% if total_paginas > 1 %}
    <div class='pm-box-header pm-flex-center' style='flex-direction: column; gap: 10px; margin-bottom: 15px; background: #fff;'>
        <div class='pm-flex-center' style='gap: 15px;'>
            {% if pagina_atual > 1 %}
                <button data-page-action='go' data-page='1' class='pm-btn-paginacao pm-btn-dark'><i class='fas fa-angle-double-left'></i></button>
                <button data-page-action='go' data-page='{{ pagina_atual - 1 }}' class='pm-btn-paginacao pm-btn-blue'><i class='fas fa-chevron-left'></i></button>
            {% endif %}
            
            <span style='font-size: 14px; color: #555;'>{{ __('Page', 'permissionsmatrix') }} 
            <input type='number' data-page-action='jump' data-max-page='{{ total_paginas }}' value='{{ pagina_atual }}' min='1' max='{{ total_paginas }}' style='width: 60px; text-align: center; padding: 3px; border: 1px solid #ccc; border-radius: 4px; font-weight: bold;'> 
            {{ __('of', 'permissionsmatrix') }} <b>{{ total_paginas }}</b></span>
            
            {% if pagina_atual < total_paginas %}
                <button data-page-action='go' data-page='{{ pagina_atual + 1 }}' class='pm-btn-paginacao pm-btn-blue'><i class='fas fa-chevron-right'></i></button>
                <button data-page-action='go' data-page='{{ total_paginas }}' class='pm-btn-paginacao pm-btn-dark'><i class='fas fa-angle-double-right'></i></button>
            {% endif %}
        </div>
        <span style='font-size: 14px; color: #333;'>{{ texto_exibindo | raw }}</span>
    </div>
{% endif %}
