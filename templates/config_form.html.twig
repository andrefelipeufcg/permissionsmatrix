<style>{{ inline_css|raw }}</style>
<script>{{ inline_js|raw }}</script>

<form method='post' action='{{ action_url }}' id='config_form' class='pm-save-form'>
<input type='hidden' name='_glpi_csrf_token' value='{{ csrf_token }}'>
<div class='center'>
    <table class='tab_cadre_fixehov'>
        <tr class='tab_bg_1'><th colspan='2'>{{ __('Plugin Access Configuration', 'permissionsmatrix') }}</th></tr>
        <tr class='tab_bg_2'>
            <td class='center' style='width: 50%; border-bottom: 0; padding-bottom: 5px;'>{{ __('Allow all profiles to generate the permissions matrix?', 'permissionsmatrix') }}</td>
            <td class='center' style='border-bottom: 0; padding-bottom: 5px;'>
                <label style='margin-right: 20px; cursor: pointer;'><input type='radio' name='allow_all' value='1' {% if allow_all == 1 %}checked{% endif %}> {{ __('Yes', 'permissionsmatrix') }}</label>
                <label style='cursor: pointer;'><input type='radio' name='allow_all' value='0' {% if allow_all == 0 %}checked{% endif %}> {{ __('No', 'permissionsmatrix') }}</label>
            </td>
        </tr>
        <tr class='tab_bg_2'>
            <td colspan='2' style='padding: 0 15px 15px 15px; border-top: 0;'>
                <div class='pm-notice-box'>
                    <strong>{{ __('Notice:', 'permissionsmatrix') }}</strong> {{ __("To grant or remove access for a specific profile to the permissions matrix, go to the desired profile and adjust this setting in the 'Permissions Matrix' tab.", 'permissionsmatrix') | raw }}
                </div>
                <div class='pm-warning-box'>
                    <strong>{{ __('Security Recommendation:', 'permissionsmatrix') }}</strong> {{ __("It is strongly recommended to restrict this permission to Super-Admin profiles only. Allowing this option for all enables regular users to view sensitive assignment and group data across the entire system.", 'permissionsmatrix') }}
                </div>
            </td>
        </tr>
        <tr class='tab_bg_2'>
            <td colspan='2' class='center'>
                <input type='hidden' name='update' value='1'>
                <button type='submit' class='vsubmit' data-saving-text='{{ __('Saving...', 'permissionsmatrix') }}'>{{ __('Save', 'permissionsmatrix') }}</button>
            </td>
        </tr>
    </table>
</div>
</form>
